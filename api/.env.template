# ============================================================================
# Market Oracle API - Environment Variables Configuration
# ============================================================================
# 
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control - it contains sensitive API keys
#
# ============================================================================
# REQUIRED: AI API Configuration
# ============================================================================

# Choose which AI provider to use: 'ANTHROPIC' or 'OPENROUTER'
# Default: ANTHROPIC
AI_API_TYPE=ANTHROPIC

# Anthropic API Key (required if AI_API_TYPE=ANTHROPIC)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenRouter API Key (required if AI_API_TYPE=OPENROUTER)
# Get your API key from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ============================================================================
# OPTIONAL: Economic Calendar Configuration
# ============================================================================
# These settings are used as defaults when running the standalone script.
# When using the API endpoints, these can be overridden per request.

# ForexFactory Configuration
# Start date for ForexFactory scraping (format: YYYY-MM-DD)
# Leave empty or set to "None" to use current week
FOREXFACTORY_START_DATE=

# Whether to use week-based scraping (true) or day-based scraping (false)
# Default: true
FOREXFACTORY_USE_WEEK=true

# TradingEconomics Configuration
# Start date for TradingEconomics scraping (format: YYYY-MM-DD)
# Leave empty or set to "None" to use default recent dates
TRADINGECONOMICS_START_DATE=

# End date for TradingEconomics scraping (format: YYYY-MM-DD)
# Leave empty or set to "None" to use default recent dates
TRADINGECONOMICS_END_DATE=

# ============================================================================
# OPTIONAL: YouTube URLs (for standalone script mode only)
# ============================================================================
# This is only used when running the script directly (python main.py without --api)
# When using the API endpoints, YouTube URLs are provided in the /validate request
# Comma-separated list of YouTube URLs to extract transcripts from
YOUTUBE_URLS=https://www.youtube.com/watch?v=dQw4w9WgXcQ,https://www.youtube.com/watch?v=jNQXAC9IVRw,https://www.youtube.com/watch?v=9bZkp7q19f0

# ============================================================================
# OPTIONAL: Polymarket API Configuration
# ============================================================================
# These keys are optional. The Polymarket API works without keys for public data access.
# API keys are only needed for enhanced features like authenticated endpoints.
# 
# To get your Polymarket API keys:
# 1. Go to https://polymarket.com/settings?tab=builder
# 2. Click ""Create"" or ""Create New"" button
# 3. Copy the apiKey, secret, and passphrase values
# 4. Paste them into the variables below

POLY_API_KEY=your_polymarket_api_key_here
POLY_API_SECRET=your_polymarket_api_secret_here
POLY_API_PASSPHRASE=your_polymarket_api_passphrase_here

# Legacy variable names (also supported, but POLY_API_* is preferred):
# POLYMARKET_API_KEY=your_polymarket_api_key_here
# POLYMARKET_API_SECRET=your_polymarket_api_secret_here
# POLYMARKET_API_PASSPHRASE=your_polymarket_api_passphrase_here

# Polymarket API Base URL (usually doesn't need to be changed)
POLYMARKET_API_BASE_URL=https://gamma-api.polymarket.com